<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/streak_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/streak_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Habit"
        android:textColor="#F4F7F5"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="0 day streak"
        android:textColor="#8FD3AD"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/streak_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="Today  0/0"
        android:textColor="#AEB8B2"
        android:textSize="12sp" />

</LinearLayout>
